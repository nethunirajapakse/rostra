# Copy these into your shell or your IDE run configurations. Never commit real values.
#
# One signing secret for the gateway and all five services. At least 32 bytes, used as raw UTF-8 text.
#   Linux/macOS:  export JWT_SECRET="$(openssl rand -base64 48)"
#   PowerShell:   $env:JWT_SECRET = [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=replace-with-a-long-random-string-at-least-32-bytes

# Optional (defaults match docker-compose.yml)
# COOKIE_SECURE=false        # set true behind HTTPS
# REDIS_HOST=localhost
# DB_PASSWORD=rostra_dev_pw
